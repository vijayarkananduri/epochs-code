class Hazard:
    def __init__(self, cid, require, x, vx):
        self.cid = cid; self.require = require
        self.x = x; self.vx = vx; self.hit = False

class RunnerEnv:
    def __init__(self, preset="no_cheat", warning_time=2.0,
                 dt=0.1, max_steps=200, seed=None):
        self.preset = preset
        if preset == "cheat":
            self.agent_speed = 0.05
            self.spawn_min, self.spawn_max = 1.0, 2.5
            self.step_penalty = 0.0
        else:
            self.agent_speed = 0.012
            self.spawn_min, self.spawn_max = 0.3, 0.8
            self.step_penalty = -0.005
        self.cases = CASES; self.n_cases = len(CASES)
        self.n_actions = 4; self.warning_time = warning_time
        self.dt = dt; self.max_steps = max_steps
        self.rng = np.random.default_rng(seed)

    @property
    def state_dim(self): return 3 + 3 * self.n_cases

    def reset(self, active_cases=None):
        if active_cases is None: active_cases = list(range(self.n_cases))
        self.active = list(active_cases)
        self.agent_x = 0.0; self.agent_h = 0
        self.step_count = 0; self.done = False
        self.hazards = []; self.warnings = {}
        self.status = {c: 'inactive' for c in self.active}
        self._schedule(delay=self.rng.uniform(self.spawn_min, self.spawn_max))
        return self._state()

    def _schedule(self, delay):
        self.next_time = delay
        avail = [c for c in self.active if self.status[c] == 'inactive']
        self.next_cid = self.rng.choice(avail) if avail else None

    def _state(self):
        s = [self.agent_x, float(self.agent_h), self.step_count / self.max_steps]
        for cid in range(self.n_cases):
            if cid not in self.active:
                s += [0.0, 0.0, 0.0]; continue
            warn = 1.0 if cid in self.warnings else 0.0
            active = 1.0 if self.status.get(cid) == 'active' else 0.0
            rel = 0.0
            for h in self.hazards:
                if h.cid == cid:
                    rel = h.x - self.agent_x; break
            s += [warn, active, rel]
        return np.array(s, dtype=np.float32)

    def step(self, a):
        if self.done: return self._state(), 0.0, True, {}
        self.step_count += 1
        if a == 0: self.agent_x = max(0.0, self.agent_x - self.agent_speed)
        elif a == 1: self.agent_x = min(1.2, self.agent_x + self.agent_speed)
        elif a == 2: self.agent_h = 1 - self.agent_h

        fired = []
        for cid in list(self.warnings.keys()):
            self.warnings[cid] -= self.dt
            if self.warnings[cid] <= 0: fired.append(cid)
        for cid in fired:
            del self.warnings[cid]; self._spawn(cid); self.status[cid] = 'active'

        if self.next_cid is not None:
            self.next_time -= self.dt
            if self.next_time <= 0:
                cid = self.next_cid
                self.warnings[cid] = self.warning_time
                self.status[cid] = 'pending'
                self._schedule(delay=self.rng.uniform(1.5, 3.5))

        for h in self.hazards: h.x += h.vx * self.dt
        for h in self.hazards:
            if not h.hit and abs(h.x - self.agent_x) < 0.06:
                if self.agent_h != h.require:
                    self.done = True
                    return self._state(), -1.0, True, {'reason': f'hit_{h.cid}'}
                else: h.hit = True

        self.hazards = [h for h in self.hazards if -0.3 < h.x < 1.4]
        for cid in list(self.status.keys()):
            if self.status[cid] == 'active' and not any(h.cid == cid for h in self.hazards):
                self.status[cid] = 'inactive'

        if self.agent_x >= 1.0:
            self.done = True
            return self._state(), 1.0, True, {'reason': 'goal'}
        if self.step_count >= self.max_steps:
            self.done = True
            return self._state(), -0.5, True, {'reason': 'timeout'}
        return self._state(), self.step_penalty, False, {}

    def _spawn(self, cid):
        c = self.cases[cid]
        req = 1 if c.hazard_type == 'air' else 0
        if self.rng.random() < 0.5:
            x = self.agent_x + 0.35; vx = -c.speed
        else:
            x = self.agent_x - 0.35; vx = c.speed
        self.hazards.append(Hazard(cid, req, x, vx))

