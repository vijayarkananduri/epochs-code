class Case:
    def __init__(self, cid, name, hazard_type, speed, plain, avoid):
        self.cid = cid; self.name = name
        self.hazard_type = hazard_type
        self.speed = speed; self.plain = plain; self.avoid = avoid
    def requires(self):
        return "JUMP" if self.hazard_type == 'air' else "STAY GROUND"

CASES = [
    Case(0, "front_ground_spike",  'air',    0.40, "a spike on the ground is sliding at me", "jump"),
    Case(1, "front_overhead_beam", 'ground', 0.40, "a beam is sweeping overhead", "stay down"),
    Case(2, "back_ground_spike",   'air',    0.70, "a spike on the ground is chasing me", "jump"),
    Case(3, "back_overhead_beam",  'ground', 0.25, "a slow beam is coming from behind", "stay down"),
    Case(4, "fast_front_spike",    'air',    0.80, "a FAST spike is rushing at me", "jump quickly"),
]

ACTION_NAMES = ["LEFT", "RIGHT", "TOGGLE", "STAY"]

def action_plain(a, airborne):
    if a == 0: return "move left"
    if a == 1: return "move right"
    if a == 2: return "jump" if not airborne else "land"
    return "stay still"

