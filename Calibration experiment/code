# SAC (discrete)
# ============================================================

class SACAgent:
    def __init__(self, sd, na, lr=3e-4, gamma=0.99, alpha=0.2,
                 tau=0.005, bs=128, target_sync=2000, buffer_cap=50000):
        self.na = na; self.gamma = gamma; self.alpha = alpha
        self.tau = tau; self.bs = bs; self.target_sync = target_sync
        self.steps = 0
        self.actor = AC(sd, na)
        self.q1 = QNet(sd, na); self.q2 = QNet(sd, na)
        self.q1t = QNet(sd, na); self.q2t = QNet(sd, na)
        self.q1t.load_state_dict(self.q1.state_dict())
        self.q2t.load_state_dict(self.q2.state_dict())
        self.opt_a = optim.Adam(self.actor.parameters(), lr=lr)
        self.opt_q = optim.Adam(list(self.q1.parameters()) + list(self.q2.parameters()), lr=lr)
        self.buf = Buf(cap=buffer_cap)
        self.eps_start = 1.0; self.eps_end = 0.05; self.eps_decay = 50000
    def eps(self):
        return self.eps_end + (self.eps_start - self.eps_end) * np.exp(-self.steps / self.eps_decay)
    @torch.no_grad()
    def q_vals(self, s):
        q1 = self.q1(torch.tensor(s, dtype=torch.float32).unsqueeze(0)).squeeze(0).numpy()
        q2 = self.q2(torch.tensor(s, dtype=torch.float32).unsqueeze(0)).squeeze(0).numpy()
        return (q1 + q2) / 2
    def act(self, s, greedy=False):
        if not greedy and random.random() < self.eps():
            return random.randrange(self.na)
        with torch.no_grad():
            logits, _ = self.actor(torch.tensor(s, dtype=torch.float32).unsqueeze(0))
            probs = torch.softmax(logits, dim=-1).squeeze(0)
            if greedy: return int(torch.argmax(probs))
            return int(torch.multinomial(probs, 1))
    def store(self, *a): self.buf.push(*a)
    def train(self):
        if len(self.buf) < self.bs: return
        batch = self.buf.sample(self.bs)
        s  = torch.tensor(np.array([b.s for b in batch]), dtype=torch.float32)
        a  = torch.tensor([b.a for b in batch], dtype=torch.long).unsqueeze(1)
        r  = torch.tensor([b.r for b in batch], dtype=torch.float32).unsqueeze(1)
        s2 = torch.tensor(np.array([b.s2 for b in batch]), dtype=torch.float32)
        d  = torch.tensor([b.d for b in batch], dtype=torch.float32).unsqueeze(1)
        with torch.no_grad():
            logits2, _ = self.actor(s2)
            probs2 = torch.softmax(logits2, dim=-1)
            logp2 = torch.log(probs2 + 1e-8)
            q1n = self.q1t(s2); q2n = self.q2t(s2)
            qn = torch.min(q1n, q2n) - self.alpha * logp2
            v = (probs2 * qn).sum(dim=1, keepdim=True)
            tgt = r + self.gamma * v * (1 - d)
        q1v = self.q1(s).gather(1, a); q2v = self.q2(s).gather(1, a)
        q_loss = nn.functional.mse_loss(q1v, tgt) + nn.functional.mse_loss(q2v, tgt)
        self.opt_q.zero_grad(); q_loss.backward(); self.opt_q.step()
        logits, _ = self.actor(s)
        probs = torch.softmax(logits, dim=-1)
        logp = torch.log(probs + 1e-8)
        with torch.no_grad():
            q1c = self.q1(s); q2c = self.q2(s)
            qc = torch.min(q1c, q2c)
        a_loss = (probs * (self.alpha * logp - qc)).sum(dim=1).mean()
        self.opt_a.zero_grad(); a_loss.backward(); self.opt_a.step()
        self.steps += 1
        if self.steps % self.target_sync == 0:
            for p, tp in [(self.q1, self.q1t), (self.q2, self.q2t)]:
                for pp, tpp in zip(p.parameters(), tp.parameters()):
                    tpp.data.copy_(self.tau * pp.data + (1 - self.tau) * tpp.data)

# ============================================================
# TRAINING
# ============================================================

def train(agent, kind, env, active, episodes=600, log_fn=None):
    for ep in range(episodes):
        s = env.reset(active_cases=active); traj = []; R = 0.0
        while True:
            if kind == "dqn":
                a = agent.act(s); s2, r, d, _ = env.step(a)
                agent.store(s, a, r, s2, d); agent.train()
            elif kind == "sac":
                a = agent.act(s); s2, r, d, _ = env.step(a)
                agent.store(s, a, r, s2, d); agent.train()
            else:
                a, logp, v = agent.act(s); s2, r, d, _ = env.step(a)
                traj.append((s, a, r, s2, float(d), logp, v))
            s = s2; R += r
            if d: break
        if kind in ("ppo", "a2c"):
            agent.update(traj)
        if log_fn and (ep+1) % 200 == 0:
            log_fn(f"    {kind} ep {ep+1:4d}  R={R:+.2f}")
    return agent

