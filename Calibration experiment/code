class A2CAgent:
    def __init__(self, sd, na, lr=7e-4, gamma=0.99, lam=0.95):
        self.na = na; self.gamma = gamma; self.lam = lam
        self.net = AC(sd, na)
        self.opt = optim.Adam(self.net.parameters(), lr=lr)
    @torch.no_grad()
    def act(self, s, greedy=False):
        logits, v = self.net(torch.tensor(s, dtype=torch.float32).unsqueeze(0))
        probs = torch.softmax(logits, dim=-1).squeeze(0)
        if greedy: a = int(torch.argmax(probs))
        else: a = int(torch.multinomial(probs, 1))
        return a, float(torch.log(probs[a] + 1e-8)), float(v.squeeze())
    @torch.no_grad()
    def q_vals(self, s):
        logits, _ = self.net(torch.tensor(s, dtype=torch.float32).unsqueeze(0))
        return logits.squeeze(0).numpy()
    def update(self, traj):
        s  = torch.tensor(np.array([t[0] for t in traj]), dtype=torch.float32)
        a  = torch.tensor([t[1] for t in traj], dtype=torch.long)
        r  = np.array([t[2] for t in traj], dtype=np.float32)
        s2 = torch.tensor(np.array([t[3] for t in traj]), dtype=torch.float32)
        d  = np.array([t[4] for t in traj], dtype=np.float32)
        old_logp = torch.tensor([t[5] for t in traj], dtype=torch.float32)
        old_v    = torch.tensor([t[6] for t in traj], dtype=torch.float32)
        with torch.no_grad():
            _, v_next = self.net(s2)
            v_next = v_next.squeeze(-1).numpy()
        adv = np.zeros_like(r); last = 0.0
        for i in reversed(range(len(r))):
            nv = 0.0 if d[i] > 0.5 else v_next[i]
            delta = r[i] + self.gamma * nv - old_v[i].item()
            last = delta + self.gamma * self.lam * (0 if d[i] > 0.5 else last)
            adv[i] = last
        ret = adv + old_v.numpy()
        adv_t = torch.tensor(adv, dtype=torch.float32)
        adv_t = (adv_t - adv_t.mean()) / (adv_t.std() + 1e-8)
        ret_t = torch.tensor(ret, dtype=torch.float32)
        logits, v = self.net(s); v = v.squeeze(-1)
        logp = torch.log_softmax(logits, dim=-1)
        new_logp = logp.gather(1, a.unsqueeze(1)).squeeze(1)
        pi_loss = -(new_logp * adv_t.detach()).mean()
        v_loss = nn.functional.mse_loss(v, ret_t)
        loss = pi_loss + 0.5 * v_loss - 0.01 * (-(torch.softmax(logits, -1) * logp).sum(-1)).mean()
        self.opt.zero_grad(); loss.backward()
        nn.utils.clip_grad_norm_(self.net.parameters(), 0.5)
        self.opt.step()

