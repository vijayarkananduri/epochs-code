BUCKETS = [
    ("very unsure",   0.00, 0.05),
    ("unsure",        0.05, 0.20),
    ("confident",     0.20, 0.50),
    ("very confident",0.50, 999.0),
]

def bucket_of(gap):
    for name, lo, hi in BUCKETS:
        if lo <= gap < hi: return name
    return "very confident"

def confidence_label(gap):
    return bucket_of(gap)

def state_narrative(env):
    parts = []
    for cid, t in env.warnings.items():
        c = env.cases[cid]
        parts.append(f"{c.plain} in {t:.1f}s")
    for h in env.hazards:
        if not h.hit:
            c = env.cases[h.cid]
            d = "toward me" if (h.vx < 0 and h.x > env.agent_x) or (h.vx > 0 and h.x < env.agent_x) else "away"
            parts.append(f"{c.name} moving {d}")
    parts.append("I am " + ("in the air" if env.agent_h else "on the ground"))
    parts.append(f"I am {int(env.agent_x*100)}% to goal")
    return "; ".join(parts)

def narrative_block(step, env, q, action, rule_action, kind):
    qs = np.argsort(-q)
    top = qs[0]; second = qs[1]
    gap = float(q[top] - q[second])
    conf = confidence_label(gap)
    sees = state_narrative(env)
    thinks = "  ".join(f"{ACTION_NAMES[i]}={q[i]:+.2f}" for i in qs)
    verb = action_plain(action, env.agent_h)
    does = f"{verb.upper()}  (chose {ACTION_NAMES[action]}, gap {gap:+.2f} over {ACTION_NAMES[second]})"
    correct = "CORRECT" if action == rule_action else f"WRONG (rule bot would {action_plain(rule_action, env.agent_h)})"
    return (
        f"[{step:03d}][{kind}] I see:    {sees}\n"
        f"         I think:  {thinks}\n"
        f"         I choose: {does}\n"
        f"         I'm sure: {conf}  ({gap:+.2f})\n"
        f"         Truth:    {correct}\n"
    )

def run_calibration(agent, env, active, kind, n_ep=200, narr_ep=1, log_fn=None, seed=99):
    e = RunnerEnv(preset=env.preset, warning_time=env.warning_time, seed=seed)
    records = defaultdict(list)
    correct_count = 0; total = 0; wins = 0
    for ep in range(n_ep):
        s = e.reset(active_cases=active); done = False; step = 0
        narr = (ep < narr_ep and log_fn is not None)
        if narr: log_fn(f"\n--- Episode {ep+1} ({kind}, {env.preset}) ---\n")
        while not done:
            q = agent.q_vals(s)
            a = int(np.argmax(q))
            rule_a = rule_based(e, s)
            gap = float(np.sort(q)[::-1][0] - np.sort(q)[::-1][1])
            records[bucket_of(gap)].append(int(a == rule_a))
            correct_count += int(a == rule_a); total += 1
            if narr: log_fn(narrative_block(step, e, q, a, rule_a, kind.upper()))
            s, r, done, info = e.step(a); step += 1
        if info.get('reason') == 'goal': wins += 1
        if narr:
            log_fn(f"--- Ended: {info.get('reason')} after {step} steps ---\n")
    return records, correct_count/total if total else 0, wins/n_ep

def calibration_table(records):
    rows = []
    for name, lo, hi in BUCKETS:
        lst = records.get(name, [])
        rows.append((name, len(lst), sum(lst)/len(lst) if lst else 0.0))
    return rows

