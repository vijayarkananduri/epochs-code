def rule_based(env, s):
    for h in env.hazards:
        if abs(h.x - env.agent_x) < 0.25:
            if h.require == 1 and env.agent_h == 0: return 2
            if h.require == 0 and env.agent_h == 1: return 2
    for cid, tt in env.warnings.items():
        if tt < 0.5:
            c = env.cases[cid]
            if c.hazard_type == 'air' and env.agent_h == 0: return 2
            if c.hazard_type == 'ground' and env.agent_h == 1: return 2
    return 1

# ============================================================
# DQN
# ============================================================

T = namedtuple('T', ('s','a','r','s2','d'))

class Buf:
    def __init__(self, cap=50000): self.b = deque(maxlen=cap)
    def push(self, *a): self.b.append(T(*a))
    def sample(self, n): return random.sample(self.b, n)
    def __len__(self): return len(self.b)

class QNet(nn.Module):
    def __init__(self, sd, na, hidden=128):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(sd, hidden), nn.ReLU(),
            nn.Linear(hidden, hidden), nn.ReLU(),
            nn.Linear(hidden, na))
    def forward(self, x): return self.net(x)

class DQNAgent:
    def __init__(self, sd, na, lr=5e-4, gamma=0.99,
                 eps_start=1.0, eps_end=0.05, eps_decay=50000,
                 bs=128, target_sync=2000):
        self.na = na; self.gamma = gamma
        self.eps_start = eps_start; self.eps_end = eps_end
        self.eps_decay = eps_decay; self.bs = bs
        self.target_sync = target_sync; self.steps = 0
        self.q = QNet(sd, na); self.qt = QNet(sd, na)
        self.qt.load_state_dict(self.q.state_dict())
        self.opt = optim.Adam(self.q.parameters(), lr=lr)
        self.buf = Buf()
    def eps(self):
        return self.eps_end + (self.eps_start - self.eps_end) * np.exp(-self.steps / self.eps_decay)
    def q_vals(self, s):
        with torch.no_grad():
            return self.q(torch.tensor(s, dtype=torch.float32).unsqueeze(0)).squeeze(0).numpy()
    def act(self, s, greedy=False):
        if not greedy and random.random() < self.eps():
            return random.randrange(self.na)
        return int(np.argmax(self.q_vals(s)))
    def store(self, *a): self.buf.push(*a)
    def train(self):
        if len(self.buf) < self.bs: return
        batch = self.buf.sample(self.bs)
        s  = torch.tensor(np.array([b.s for b in batch]), dtype=torch.float32)
        a  = torch.tensor([b.a for b in batch], dtype=torch.long).unsqueeze(1)
        r  = torch.tensor([b.r for b in batch], dtype=torch.float32).unsqueeze(1)
        s2 = torch.tensor(np.array([b.s2 for b in batch]), dtype=torch.float32)
        d  = torch.tensor([b.d for b in batch], dtype=torch.float32).unsqueeze(1)
        q = self.q(s).gather(1, a)
        with torch.no_grad():
            qn = self.qt(s2).max(dim=1, keepdim=True)[0]
            tgt = r + self.gamma * qn * (1 - d)
        loss = nn.functional.mse_loss(q, tgt)
        self.opt.zero_grad(); loss.backward(); self.opt.step()
        self.steps += 1
        if self.steps % self.target_sync == 0:
            self.qt.load_state_dict(self.q.state_dict())

